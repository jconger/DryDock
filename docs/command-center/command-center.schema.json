{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DryDock Config",
  "type": "object",
  "properties": {
    "repo": {
      "type": "object",
      "properties": {
        "defaultBranch": { "type": "string" }
      }
    },
    "labels": { "type": "object" },
    "branches": { "type": "object" },
    "commands": { "type": "object" },
    "qa": { "type": "object" },
    "templates": { "type": "object" },
    "watch": {
      "type": "object",
      "properties": {
        "pollIntervalSeconds": { "type": "number" },
        "debounceMs": { "type": "number" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "path": { "type": "string" },
              "enabled": { "type": "boolean" },
              "mode": { "type": "string", "enum": ["mtime", "mtime+hash"] },
              "maxFileSizeKb": { "type": "number" },
              "parser": { "type": "object" },
              "proposal": { "type": "object" }
            }
          }
        }
      }
    },
    "scheduler": {
      "type": "object",
      "properties": {
        "timezone": { "type": "string" },
        "maxConcurrency": { "type": "number" },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "enabled": { "type": "boolean" },
              "cron": { "type": "string" },
              "intervalSeconds": { "type": "number" },
              "task": { "type": "string" },
              "args": { "type": ["object", "array", "string", "null"] },
              "repo": {
                "type": "object",
                "properties": {
                  "owner": { "type": "string" },
                  "name": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "socketPath": { "type": "string" },
        "pidPath": { "type": "string" },
        "logPath": { "type": "string" },
        "maxConcurrency": { "type": "number" }
      }
    },
    "commentProtocol": {
      "type": "object",
      "properties": {
        "prefix": { "type": "string" },
        "commands": { "type": "object" }
      }
    },
    "agentHarness": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["opencode", "codex", "claude-code"] },
        "commandPrefix": { "type": "string" },
        "commands": {
          "type": "object",
          "properties": {
            "proposePlans": { "type": "string" },
            "implement": { "type": "string" },
            "fixRobust": { "type": "string" }
          }
        },
        "exec": {
          "type": "object",
          "properties": {
            "bin": { "type": "string" },
            "args": {
              "type": ["array", "string"],
              "items": { "type": "string" }
            },
            "stdin": { "type": "boolean" }
          }
        }
      }
    }
  }
}
