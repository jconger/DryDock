{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DryDock Config",
  "type": "object",
  "properties": {
    "repo": {
      "type": "object",
      "properties": {
        "defaultBranch": { "type": "string" }
      }
    },
    "labels": { "type": "object" },
    "branches": { "type": "object" },
    "commands": { "type": "object" },
    "qa": { "type": "object" },
    "templates": { "type": "object" },
    "commentProtocol": {
      "type": "object",
      "properties": {
        "prefix": { "type": "string" },
        "commands": { "type": "object" }
      }
    },
    "agentHarness": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["opencode", "codex", "claude-code"] },
        "commandPrefix": { "type": "string" },
        "commands": {
          "type": "object",
          "properties": {
            "proposePlans": { "type": "string" },
            "implement": { "type": "string" },
            "fixRobust": { "type": "string" }
          }
        }
      }
    }
  }
}
